{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostatlas.local/schemas/work-packet.schema.json",
  "title": "WorkPacket",
  "type": "object",
  "required": ["packet_id", "trace_id", "objective", "expected_outputs", "required_capabilities", "authority", "risk_class", "verification_plan", "proof_class", "failure_route"],
  "properties": {
    "packet_id": {"type": "string"},
    "trace_id": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object"},
    "risk_class": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "verification_plan": {"type": "array", "items": {"type": "string"}},
    "proof_class": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "failure_route": {"type": "string"}
  },
  "additionalProperties": false
}